<Style xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       TargetType="{x:Type CheckBox}">
  <Setter Property="Foreground" Value="{DynamicResource FluentText}" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="MinHeight" Value="30" />
  <Setter Property="Template">
    <Setter.Value>
      <ControlTemplate TargetType="{x:Type CheckBox}">
        <Grid Background="Transparent" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border x:Name="Track" Width="36" Height="20" CornerRadius="10"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Background="{DynamicResource FluentField}"
                  BorderBrush="{DynamicResource FluentSecondaryText}" BorderThickness="1">
            <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="3,0,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Fill="{DynamicResource FluentSecondaryText}" />
          </Border>
          <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                            RecognizesAccessKey="True"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Track" Property="Background" Value="{DynamicResource FluentAccent}" />
            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FluentAccent}" />
            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource FluentAccentText}" />
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Opacity"
                                   To="0.82" Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </Trigger.EnterActions>
            <Trigger.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Opacity"
                                   To="1" Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.45" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value>
  </Setter>
</Style>
